{
  "designSystem": {
    "name": "Monika Planner Design System",
    "version": "2.0",
    "description": "Custom, distinctive design language for the Monika Planner app with modern gradients, unique color palette, and bold typography"
  },

  "colorPalette": {
    "primary": {
      "brand": "#6366F1",
      "brandDark": "#4F46E5",
      "brandLight": "#818CF8",
      "brandGlow": "#A5B4FC",
      "brandSubtle": "#E0E7FF"
    },
    "secondary": {
      "accent": "#EC4899",
      "accentDark": "#DB2777",
      "accentLight": "#F472B6",
      "accentSubtle": "#FCE7F3"
    },
    "gradient": {
      "primary": ["#6366F1", "#EC4899"],
      "secondary": ["#818CF8", "#F472B6"],
      "dark": ["#4F46E5", "#DB2777"],
      "subtle": ["#E0E7FF", "#FCE7F3"]
    },
    "neutral": {
      "black": "#0F172A",
      "slate900": "#1E293B",
      "slate800": "#334155",
      "slate700": "#475569",
      "slate600": "#64748B",
      "slate500": "#94A3B8",
      "slate400": "#CBD5E1",
      "slate300": "#E2E8F0",
      "slate200": "#F1F5F9",
      "slate100": "#F8FAFC",
      "white": "#FFFFFF"
    },
    "semantic": {
      "success": "#10B981",
      "successLight": "#D1FAE5",
      "warning": "#F59E0B",
      "warningLight": "#FEF3C7",
      "error": "#EF4444",
      "errorLight": "#FEE2E2",
      "info": "#3B82F6",
      "infoLight": "#DBEAFE"
    },
    "background": {
      "primary": "#FFFFFF",
      "secondary": "#F8FAFC",
      "tertiary": "#F1F5F9",
      "dark": "#0F172A",
      "darkSecondary": "#1E293B",
      "overlay": "rgba(15, 23, 42, 0.7)",
      "glass": "rgba(255, 255, 255, 0.7)"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "tertiary": "#94A3B8",
      "inverse": "#FFFFFF",
      "brand": "#6366F1",
      "accent": "#EC4899"
    }
  },

  "typography": {
    "fontFamily": {
      "primary": "SF Pro Rounded",
      "display": "SF Pro Display",
      "text": "SF Pro Text",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "heavy": 800,
      "black": 900
    },
    "styles": {
      "displayLarge": {
        "fontSize": 40,
        "lineHeight": 48,
        "fontWeight": 900,
        "letterSpacing": -0.5
      },
      "displayMedium": {
        "fontSize": 32,
        "lineHeight": 40,
        "fontWeight": 800,
        "letterSpacing": -0.4
      },
      "largeTitle": {
        "fontSize": 28,
        "lineHeight": 36,
        "fontWeight": 700,
        "letterSpacing": -0.3
      },
      "title1": {
        "fontSize": 24,
        "lineHeight": 32,
        "fontWeight": 700,
        "letterSpacing": -0.2
      },
      "title2": {
        "fontSize": 20,
        "lineHeight": 28,
        "fontWeight": 600,
        "letterSpacing": -0.1
      },
      "title3": {
        "fontSize": 18,
        "lineHeight": 24,
        "fontWeight": 600,
        "letterSpacing": 0
      },
      "headline": {
        "fontSize": 16,
        "lineHeight": 22,
        "fontWeight": 600,
        "letterSpacing": 0
      },
      "body": {
        "fontSize": 16,
        "lineHeight": 24,
        "fontWeight": 400,
        "letterSpacing": 0
      },
      "bodyEmphasis": {
        "fontSize": 16,
        "lineHeight": 24,
        "fontWeight": 600,
        "letterSpacing": 0
      },
      "callout": {
        "fontSize": 15,
        "lineHeight": 22,
        "fontWeight": 500,
        "letterSpacing": 0
      },
      "subheadline": {
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": 500,
        "letterSpacing": 0
      },
      "footnote": {
        "fontSize": 13,
        "lineHeight": 18,
        "fontWeight": 400,
        "letterSpacing": 0
      },
      "caption": {
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": 500,
        "letterSpacing": 0.5
      },
      "overline": {
        "fontSize": 11,
        "lineHeight": 16,
        "fontWeight": 600,
        "letterSpacing": 1,
        "textTransform": "uppercase"
      }
    }
  },

  "spacing": {
    "scale": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "base": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 40,
      "3xl": 48,
      "4xl": 64
    },
    "component": {
      "cardPadding": 16,
      "sectionPadding": 24,
      "screenPadding": 24,
      "listItemPadding": 16,
      "bottomSheetPadding": 24
    }
  },

  "borderRadius": {
    "none": 0,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "full": 9999,
    "component": {
      "button": 16,
      "buttonLarge": 20,
      "card": 20,
      "cardLarge": 24,
      "image": 16,
      "modal": 24,
      "sheet": 24,
      "chip": 24,
      "input": 12,
      "badge": 12
    }
  },

  "shadows": {
    "none": {
      "shadowColor": "#000000",
      "shadowOffset": { "width": 0, "height": 0 },
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "elevation": 0
    },
    "small": {
      "shadowColor": "#6366F1",
      "shadowOffset": { "width": 0, "height": 2 },
      "shadowOpacity": 0.08,
      "shadowRadius": 4,
      "elevation": 2
    },
    "medium": {
      "shadowColor": "#6366F1",
      "shadowOffset": { "width": 0, "height": 4 },
      "shadowOpacity": 0.12,
      "shadowRadius": 12,
      "elevation": 4
    },
    "large": {
      "shadowColor": "#6366F1",
      "shadowOffset": { "width": 0, "height": 8 },
      "shadowOpacity": 0.16,
      "shadowRadius": 24,
      "elevation": 8
    },
    "colored": {
      "shadowColor": "#6366F1",
      "shadowOffset": { "width": 0, "height": 4 },
      "shadowOpacity": 0.2,
      "shadowRadius": 16,
      "elevation": 6
    },
    "glow": {
      "shadowColor": "#6366F1",
      "shadowOffset": { "width": 0, "height": 0 },
      "shadowOpacity": 0.3,
      "shadowRadius": 20,
      "elevation": 4
    }
  },

  "components": {
    "navigationBar": {
      "height": 44,
      "backgroundColor": "#FFFFFF",
      "titleColor": "#222222",
      "tintColor": "#222222",
      "shadowOpacity": 0,
      "translucent": true,
      "largeTitleEnabled": true,
      "largeTitleColor": "#222222",
      "backButtonStyle": "arrow"
    },

    "tabBar": {
      "height": 80,
      "backgroundColor": "#FFFFFF",
      "borderTopWidth": 0,
      "shadowEnabled": true,
      "shadowColor": "#6366F1",
      "shadowOpacity": 0.1,
      "shadowRadius": 20,
      "activeTintColor": "#6366F1",
      "inactiveTintColor": "#94A3B8",
      "activeBackground": "#E0E7FF",
      "activeBackgroundRadius": 16,
      "iconSize": 24,
      "labelFontSize": 11,
      "labelFontWeight": 600,
      "padding": 8,
      "itemSpacing": 4,
      "indicatorEnabled": true,
      "indicatorHeight": 3,
      "indicatorColor": "#6366F1"
    },

    "searchBar": {
      "height": 56,
      "backgroundColor": "#FFFFFF",
      "borderRadius": 28,
      "shadowEnabled": true,
      "shadowColor": "#000000",
      "shadowOpacity": 0.12,
      "shadowRadius": 8,
      "paddingHorizontal": 20,
      "iconSize": 20,
      "iconColor": "#222222",
      "placeholderColor": "#717171",
      "textColor": "#222222",
      "fontSize": 16
    },

    "card": {
      "borderRadius": 20,
      "backgroundColor": "#FFFFFF",
      "shadowEnabled": true,
      "shadowColor": "#6366F1",
      "shadowOpacity": 0.12,
      "shadowRadius": 12,
      "borderWidth": 0,
      "overflow": "hidden",
      "imageAspectRatio": 1.05,
      "imageCornerRadius": 16,
      "contentPadding": 16,
      "spacing": 12,
      "hoverScale": 1.02,
      "pressScale": 0.98
    },
    
    "cardGlass": {
      "borderRadius": 20,
      "backgroundColor": "rgba(255, 255, 255, 0.7)",
      "backdropBlur": 20,
      "borderWidth": 1,
      "borderColor": "rgba(255, 255, 255, 0.3)",
      "shadowEnabled": true,
      "contentPadding": 16,
      "spacing": 12
    },
    
    "cardGradient": {
      "borderRadius": 20,
      "background": "gradient",
      "gradientColors": ["#6366F1", "#EC4899"],
      "shadowEnabled": true,
      "shadowColor": "#6366F1",
      "shadowOpacity": 0.3,
      "shadowRadius": 20,
      "contentPadding": 20,
      "spacing": 12
    },

    "listingCard": {
      "imageHeight": 280,
      "imageCornerRadius": 12,
      "heartIconSize": 24,
      "heartIconPosition": { "top": 12, "right": 12 },
      "starIconSize": 12,
      "starColor": "#222222",
      "ratingFontSize": 15,
      "titleFontSize": 15,
      "titleFontWeight": 400,
      "titleColor": "#222222",
      "subtitleFontSize": 15,
      "subtitleColor": "#717171",
      "priceFontSize": 15,
      "priceFontWeight": 600,
      "priceColor": "#222222",
      "spacing": 8
    },

    "button": {
      "primary": {
        "background": "gradient",
        "gradientColors": ["#6366F1", "#EC4899"],
        "textColor": "#FFFFFF",
        "borderRadius": 16,
        "height": 56,
        "fontSize": 16,
        "fontWeight": 600,
        "paddingHorizontal": 32,
        "shadowEnabled": true,
        "disabledBackgroundColor": "#CBD5E1",
        "disabledTextColor": "#94A3B8"
      },
      "secondary": {
        "backgroundColor": "#E0E7FF",
        "textColor": "#6366F1",
        "borderRadius": 16,
        "height": 56,
        "fontSize": 16,
        "fontWeight": 600,
        "paddingHorizontal": 32
      },
      "outline": {
        "backgroundColor": "transparent",
        "textColor": "#6366F1",
        "borderWidth": 2,
        "borderColor": "#6366F1",
        "borderRadius": 16,
        "height": 56,
        "fontSize": 16,
        "fontWeight": 600,
        "paddingHorizontal": 32
      },
      "ghost": {
        "backgroundColor": "transparent",
        "textColor": "#6366F1",
        "fontSize": 16,
        "fontWeight": 600,
        "paddingHorizontal": 16,
        "paddingVertical": 12
      },
      "small": {
        "height": 44,
        "fontSize": 14,
        "paddingHorizontal": 20,
        "borderRadius": 12
      },
      "icon": {
        "size": 48,
        "borderRadius": 16,
        "backgroundColor": "#E0E7FF"
      }
    },

    "input": {
      "height": 56,
      "borderRadius": 8,
      "borderWidth": 1,
      "borderColor": "#B0B0B0",
      "focusBorderColor": "#222222",
      "backgroundColor": "#FFFFFF",
      "textColor": "#222222",
      "placeholderColor": "#717171",
      "fontSize": 16,
      "paddingHorizontal": 16,
      "paddingVertical": 16
    },

    "chip": {
      "borderRadius": 20,
      "backgroundColor": "#FFFFFF",
      "borderWidth": 1,
      "borderColor": "#DDDDDD",
      "activeBorderColor": "#222222",
      "activeBackgroundColor": "#F7F7F7",
      "textColor": "#222222",
      "fontSize": 14,
      "fontWeight": 600,
      "paddingHorizontal": 16,
      "paddingVertical": 10,
      "minHeight": 40
    },

    "avatar": {
      "sizes": {
        "small": 32,
        "medium": 40,
        "large": 64,
        "xlarge": 96
      },
      "borderRadius": 9999,
      "borderWidth": 0,
      "backgroundColor": "#DDDDDD",
      "iconColor": "#717171"
    },

    "badge": {
      "backgroundColor": "#FF5A5F",
      "textColor": "#FFFFFF",
      "fontSize": 11,
      "fontWeight": 600,
      "borderRadius": 10,
      "minWidth": 20,
      "height": 20,
      "paddingHorizontal": 6
    },

    "divider": {
      "height": 1,
      "backgroundColor": "#EBEBEB",
      "marginVertical": 16
    },

    "bottomSheet": {
      "backgroundColor": "#FFFFFF",
      "borderTopLeftRadius": 16,
      "borderTopRightRadius": 16,
      "handleWidth": 36,
      "handleHeight": 4,
      "handleColor": "#DDDDDD",
      "handleMarginTop": 8,
      "paddingHorizontal": 24,
      "paddingTop": 24,
      "paddingBottom": 32
    },

    "modal": {
      "backgroundColor": "#FFFFFF",
      "borderRadius": 16,
      "padding": 24,
      "maxWidth": 400,
      "overlayColor": "rgba(0, 0, 0, 0.6)"
    },

    "imageGallery": {
      "aspectRatio": 1.05,
      "borderRadius": 12,
      "indicatorColor": "#FFFFFF",
      "indicatorSize": 8,
      "indicatorSpacing": 6,
      "indicatorBottomOffset": 16
    },

    "rating": {
      "starSize": 12,
      "starColor": "#222222",
      "fontSize": 15,
      "fontWeight": 400,
      "spacing": 4
    },

    "toast": {
      "backgroundColor": "#222222",
      "textColor": "#FFFFFF",
      "fontSize": 15,
      "borderRadius": 8,
      "paddingHorizontal": 16,
      "paddingVertical": 12,
      "minHeight": 48,
      "maxWidth": 343
    }
  },

  "layout": {
    "grid": {
      "columns": 12,
      "gutter": 16,
      "margin": 24
    },
    "breakpoints": {
      "mobile": 320,
      "tablet": 768,
      "desktop": 1024
    },
    "safeAreaInsets": {
      "top": 44,
      "bottom": 34,
      "left": 0,
      "right": 0
    }
  },

  "animations": {
    "durations": {
      "instant": 100,
      "fast": 200,
      "normal": 300,
      "slow": 400,
      "verySlow": 500
    },
    "easings": {
      "default": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "easeIn": "cubic-bezier(0.4, 0.0, 1, 1)",
      "easeOut": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "spring": { "tension": 40, "friction": 7 }
    },
    "transitions": {
      "fade": {
        "duration": 200,
        "easing": "easeInOut"
      },
      "slide": {
        "duration": 300,
        "easing": "easeOut"
      },
      "scale": {
        "duration": 200,
        "easing": "spring"
      }
    }
  },

  "interactions": {
    "touchableOpacity": {
      "activeOpacity": 0.7,
      "pressRetentionOffset": {
        "top": 20,
        "left": 20,
        "bottom": 20,
        "right": 20
      }
    },
    "haptics": {
      "selection": "light",
      "impact": "medium",
      "notification": "success"
    },
    "gestures": {
      "swipeThreshold": 50,
      "longPressDelay": 500
    }
  },

  "imagery": {
    "aspectRatios": {
      "listing": 1.05,
      "hero": 0.75,
      "square": 1,
      "wide": 1.78,
      "experience": 1.5
    },
    "placeholders": {
      "backgroundColor": "#EBEBEB",
      "shimmerColor": "#F7F7F7"
    },
    "optimization": {
      "quality": 85,
      "format": "webp",
      "lazyLoad": true,
      "progressive": true
    }
  },

  "patterns": {
    "lists": {
      "itemSpacing": 24,
      "sectionHeaderHeight": 32,
      "sectionHeaderFontSize": 22,
      "sectionHeaderFontWeight": 700,
      "separatorColor": "#EBEBEB",
      "separatorHeight": 1
    },
    "forms": {
      "labelFontSize": 12,
      "labelFontWeight": 600,
      "labelColor": "#222222",
      "labelMarginBottom": 8,
      "errorColor": "#FF5A5F",
      "errorFontSize": 13,
      "helperTextColor": "#717171",
      "helperTextFontSize": 13,
      "fieldSpacing": 24
    },
    "emptyStates": {
      "iconSize": 96,
      "iconColor": "#DDDDDD",
      "titleFontSize": 22,
      "titleFontWeight": 700,
      "titleColor": "#222222",
      "descriptionFontSize": 17,
      "descriptionColor": "#717171",
      "spacing": 16
    },
    "loading": {
      "spinnerSize": 24,
      "spinnerColor": "#FF5A5F",
      "skeletonBaseColor": "#EBEBEB",
      "skeletonHighlightColor": "#F7F7F7"
    }
  },

  "accessibility": {
    "minimumTouchTarget": 44,
    "contrastRatios": {
      "normalText": 4.5,
      "largeText": 3.0,
      "uiComponents": 3.0
    },
    "focusIndicatorWidth": 2,
    "focusIndicatorColor": "#007AFF"
  },

  "designPrinciples": {
    "uniqueness": "Distinctive gradient-driven design that stands out from standard iOS apps",
    "boldness": "Bold typography, vibrant colors, and confident visual presence",
    "modernism": "Contemporary design with generous rounded corners and depth",
    "fluidity": "Smooth animations, gradient transitions, and flowing interactions",
    "hierarchy": "Clear visual hierarchy with heavy display fonts and gradient accents",
    "personality": "Playful use of color, shadows, and rounded shapes to create character",
    "depth": "Multi-layered design with shadows, gradients, and glass effects",
    "gestureFirst": "Optimized for touch with large hit areas and tactile feedback",
    "consistency": "Systematic use of design tokens while allowing creative expression"
  },

  "iconography": {
    "style": "SF Symbols (iOS native)",
    "weight": "regular",
    "sizes": {
      "small": 16,
      "medium": 20,
      "large": 24,
      "xlarge": 32
    },
    "color": "#222222",
    "activeColor": "#FF5A5F"
  }
}
